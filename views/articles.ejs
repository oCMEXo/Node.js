<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Articles</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 0; background: #f3f4f6; }
    header { background: #111827; color: white; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    header a { color: #e5e7eb; text-decoration: none; margin-right: 1rem; }
    header a:hover { color: white; }
    main { max-width: 960px; margin: 1.5rem auto 2rem; background: white; padding: 1.5rem; border-radius: 0.75rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1); }
    .btn { display: inline-block; padding: .5rem .9rem; border-radius: .5rem; border: none; cursor: pointer; text-decoration: none; font-size: 0.9rem; }
    .btn-primary { background: #2563eb; color: white; }
    .btn-secondary { background: #6b7280; color: white; }
    .btn-danger { background: #dc2626; color: white; }
    .btn-sm { padding: 0.3rem 0.5rem; font-size: 0.8rem; }
    .btn + .btn { margin-left: .25rem; }
    form { margin: 0; }
    label { display: block; margin-bottom: .25rem; font-weight: 600; }
    input[type=text], textarea, select { width: 100%; padding: .5rem .6rem; border-radius: .5rem; border: 1px solid #d1d5db; margin-bottom: .75rem; font-size: 0.95rem; }
    textarea { min-height: 120px; resize: vertical; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: .5rem .3rem; border-bottom: 1px solid #e5e7eb; text-align: left; font-size: 0.9rem; vertical-align: top; }
    th { background: #f9fafb; font-weight: 600; }
    .muted { color: #6b7280; font-size: 0.85rem; }
    .workspace-switcher { margin-bottom: 1rem; padding-bottom: .75rem; border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; }
    .workspace-switcher select { width: auto; min-width: 200px; }
    .tag { display: inline-block; padding: .1rem .45rem; font-size: .75rem; border-radius: 999px; background: #e5e7eb; color: #374151; }
    .comment { border: 1px solid #e5e7eb; border-radius: .5rem; padding: .5rem .6rem; margin-bottom: .5rem; background: #f9fafb; }
    .comment-header { display: flex; justify-content: space-between; font-size: .8rem; color: #6b7280; margin-bottom: .25rem; }
    .article-body { white-space: pre-wrap; font-size: 0.95rem; line-height: 1.45; }
    .attachment { margin-top: .5rem; font-size: .85rem; }
    .version-badge { display: inline-block; padding: .1rem .4rem; border-radius: 999px; font-size: .7rem; margin-left: .25rem; background: #e0f2fe; color: #0369a1; }
    .version-warning { background: #fef3c7; border-radius: .5rem; padding: .4rem .6rem; font-size: .85rem; margin-bottom: .75rem; color: #92400e; }
    .versions-list { margin-top: 1rem; font-size: .85rem; }
    .versions-list ul { list-style: none; padding-left: 0; }
    .versions-list li { margin-bottom: .2rem; }
</style>
</head>
<body>
<header>
  <div>
    <a href="/workspaces"><strong>Workspaces</strong></a>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <span class="muted" style="margin-left: .75rem;">Logged in as <%= currentUser.email %> (<%= currentUser.role %>)</span>
    <% } %>
  </div>
  <div>
    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
      <a href="/admin/users">User Management</a>
    <% } %>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/logout">Logout</a>
    <% } %>
  </div>
</header>
<main>
  <form method="get" style="margin-bottom:1rem;">
    <input
      type="text"
      name="query"
      placeholder="Search articles..."
      value="<%= typeof query !== 'undefined' ? query : '' %>"
      style="padding:.4rem .6rem; width:60%;"
    />
    <button type="submit">Search</button>
  </form>

<h1>Articles</h1>

<div class="workspace-switcher">
  <div>
    <form method="GET" action="/workspaces/<%= workspace.id %>/articles">
      <label for="ws">Workspace</label>
      <select id="ws" name="ws" onchange="if (this.value) window.location = '/workspaces/' + this.value + '/articles';">
        <% workspaces.forEach(function(ws){ %>
          <option value="<%= ws.id %>" <%= ws.id === workspace.id ? 'selected' : '' %>><%= ws.name %></option>
        <% }); %>
      </select>
    </form>
  </div>
  <div>
    <a href="/workspaces/<%= workspace.id %>/articles/new" class="btn btn-primary">+ New article</a>
    <a href="/workspaces" class="btn btn-secondary">Back to workspaces</a>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Latest version</th>
      <th>Comments</th>
      <th style="width: 200px;">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (!articles || articles.length === 0) { %>
      <tr>
        <td colspan="4" class="muted">No articles in this workspace yet.</td>
      </tr>
    <% } else { %>
      <% articles.forEach(function(a){ %>
        <tr>
          <td><%= a.title %></td>
          <td><span class="tag">v<%= a.latest_version %></span></td>
          <td><%= a.comment_count %></td>
          <td>
            <a href="/articles/<%= a.id %>" class="btn btn-sm btn-primary">Open</a>
            <a href="/articles/<%= a.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
            <form method="POST" action="/articles/<%= a.id %>" style="display:inline;" onsubmit="return confirm('Delete article and all its versions/comments?');">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>

</main>
</body>
</html>
